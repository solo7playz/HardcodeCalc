<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ax² + bx + c = 0"
        android:textSize="22sp"
        android:textColor="#00ff88"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/quadraticA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="a (коэффициент при x²)"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textColor="#000000"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/quadraticB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="b (коэффициент при x)"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textColor="#000000"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/quadraticC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="c (свободный член)"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textColor="#000000"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSolveQuadratic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Решить"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#e94560" />

    <TextView
        android:id="@+id/quadraticD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D = "
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/quadraticResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="x₁ = \nx₂ = "
        android:textSize="20sp"
        android:textColor="#00ff88"
        android:padding="12dp" />

</LinearLayout>
